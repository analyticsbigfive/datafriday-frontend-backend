/// Référentiel de formats de conditionnement (Cup, Fût, Box...) pour
/// MarketPrice.purchasePackaging/inventoryPackaging (String, non-FK — la valeur
/// stockée est le NOM choisi ici, comme goodType/category). Indépendant de
/// MarketPriceType/MarketPriceCategory (Good Type/Good Category, classification
/// du produit) et du modèle Packaging (composant de recette avec coût propre).
model PackingType {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Référentiel de conditions de stockage (Cold/Dry/Frozen par défaut, CRUD-éditable dans
/// Configurations). Comme PackingType, la valeur stockée sur Ingredient/Packaging/MenuComponent/
/// MenuItem/les 3 tables de snapshot est le NOM (String, non-FK), avec cascade de renommage
/// en transaction dans StorageTypesService.update(). `code` est distinct de `name` : il porte
/// l'identifiant STABLE ('dry'|'cold'|'belowzero') déjà persisté tel quel dans
/// SpaceElement.subtypes[] par le tool "Storage" du Builder v2 (elementTaxonomy.js) — seules les
/// 3 lignes historiques seedées en ont un, jamais éditable, pour que renommer/traduire "Cold" ne
/// casse jamais les éléments Storage déjà posés en plan. Lignes avec `code` non-null : rename
/// autorisé, delete bloqué (StorageTypesService.remove()).
model StorageType {
  id        String   @id @default(cuid())
  name      String
  code      String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// CFG-2 (taxonomie unifiée) — Étape 1 : référentiel des "départements" (types d'outil Builder v2 /
/// départements RH). GLOBAL, pas par tenant — un seul jeu de départements/sous-types pour toute la
/// plateforme (décision explicite : "les 8 départements sont pareils pour tout le monde"), édition
/// réservée au super-admin plateforme (SuperAdminGuard), lecture ouverte à tout utilisateur
/// authentifié. `code` porte l'identifiant STABLE des 8 départements historiques
/// (shop/hospitality/merchshop/storage/entrance/kitchen/entertainment/access) — même mécanisme que
/// StorageType.code : SpaceElement.type (Étape 2, pas encore fait) stockera `code ?? id`, jamais
/// `name` (renommable), pour que renommer un département ne casse jamais les éléments déjà posés
/// en plan. `needsRh`/`isSeller`/`allowsSuppliers` remplacent (à partir de l'Étape 3/4, pas encore
/// branché) les listes dispersées sectionsForType()/STAFFING_ELEMENT_TYPES/SELLER_TYPES/
/// HR_SUPPLIER_DEPARTMENTS. À la fin de l'Étape 1, RIEN ne lit encore cette table —
/// SpaceElement.type, HrRole.department, HrSupplier.departments et elementTaxonomy.js restent
/// inchangés (voir plan "Taxonomie unifiée Département/Sous-type").
model Department {
  id              String   @id @default(cuid())
  name            String
  code            String? // stable pour les 8 départements historiques, null si créé par le super-admin
  color           String
  icon            String // nom d'icône MDI, ex. "mdi-store"
  needsRh         Boolean  @default(false)
  isSeller        Boolean  @default(false)
  allowsSuppliers Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subtypes Subtype[]

  @@unique([name])
}

/// CFG-2 — sous-type d'un Department (ex. "Beverages" sous "F&B"). Global comme Department (pas
/// par tenant). Même mécanisme `code` que Department (et que StorageType) pour les ~35 sous-types
/// historiques déjà persistés tels quels dans SpaceElement.subtypes[]
/// (elementTaxonomy.js TOOLS[].subtypes).
model Subtype {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  code         String? // stable pour les sous-types historiques, null si créé par le super-admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, name])
  @@index([departmentId])
}

// ==================== MENU ITEMS ====================

model MenuItem {
  id                     String       @id @default(cuid())
  name                   String
  typeId                 String? // FK to ProductType (optional)
  categoryId             String? // FK to ProductCategory (optional)
  brandId                String? // FK to Brand (optional)
  displayNameId          String? // FK to DisplayName (optional)
  seasonId               String? // FK to Season (Custom Date de Configuration, optional)
  diet                   Diet[]
  allergens              String[]
  picture                String?
  basePrice              Decimal      @db.Decimal(10, 2)
  vatRate                Decimal?     @db.Decimal(5, 2) // Taux TVA % par article (null → défaut tenant)
  discountType           String? // Remise catalogue : "percent" | "amount" | null
  discountValue          Decimal?     @db.Decimal(10, 2) // Valeur remise (% si percent, montant TTC si amount)
  totalCost              Decimal?     @db.Decimal(12, 4)
  margin                 Float?
  description            String?
  storageType            String[]
  readyForSale           String? // "Yes", "No" ou null
  kitchenType            KitchenType? // Cuisine Centrale/Locale, saisi quand readyForSale = "Yes"
  comboItem              String? // "Yes", "No" ou null — flag « réutilisable dans un combo »
  isCombo                Boolean      @default(false) // « cet item EST un combo » (posé quand il a des comboChildren) — distinct de comboItem
  numberOfPiecesRecipe   Int?
  componentsData         Json? // Pour stocker les components JSON de Figma
  inventoryPackagingType String? // Type de conditionnement inventaire (ex: Box, Bag)
  inventoryNumberOfUnits Float? // Nombre d'unités par conditionnement
  inventoryUnit          String? // Unité du conditionnement inventaire (ex: Kg, L, Pc)
  // ⚠️ spaceIds (String[]) et spacePrices (Json) existent encore en DB mais sont GELÉS
  // (source de vérité = table SpaceMenuItem, cf. modèle plus bas). Retirés du schéma pour
  // que tout code qui les référencerait encore casse à la compilation. Drop DB différé
  // (migration de nettoyage après validation).
  tenantId               String
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productType     ProductType?                @relation(fields: [typeId], references: [id])
  productCategory ProductCategory?            @relation(fields: [categoryId], references: [id])
  brand           Brand?                      @relation(fields: [brandId], references: [id])
  displayName     DisplayName?                @relation(fields: [displayNameId], references: [id])
  season          Season?                     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  components      MenuItemComponent[]
  ingredients     MenuItemIngredient[]
  packagings      MenuItemPackaging[]
  menuAssignments MenuAssignment[]
  salesMappings   ProductMapping[]
  priceHistory    MenuItemPriceHistory[]
  spaceLinks      SpaceMenuItem[]
  // Composition "Combo"/"Menu" par d'autres MenuItem vendables (ex. "Burger + Frites" = composé
  // de "Burger" + "Frites"), distincte de `comboItem` (flag scalaire "cet item est réutilisable
  // tel quel dans un combo") et de `components[]` (qui pointe vers MenuComponent, pas MenuItem).
  comboChildren   MenuItemCombo[]             @relation("ComboParentToChild")
  comboParents    MenuItemCombo[]             @relation("ComboChildToParent")
  salesInputs     ElementMenuItemSalesInput[]
  // Promotion portée par CET item (0 ou 1) + promotions où CET item est le produit remisé.
  promotion               Promotion?  @relation("MenuItemPromotion")
  discountedInPromotions  Promotion[] @relation("PromotionDiscountedProduct")

  @@index([tenantId])
  @@index([name])
  @@index([typeId])
  @@index([categoryId])
  @@index([brandId])
  @@index([displayNameId])
  @@index([seasonId])
  @@index([readyForSale])
  @@index([tenantId, deletedAt])
}

/// Type de promotion (référentiel de configuration, comme DisplayName) — alimente le select
/// « type de promotion » d'une Promotion. Géré dans Configuration > Types de promotion.
model PromotionType {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  createdAt DateTime @default(now())

  promotions Promotion[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Promotion attachée à UN menu item (0 ou 1 par item, `menuItemId @unique`). Quand un menu
/// item « est en promotion », il désigne un produit remisé (`discountedProduct`, un autre
/// MenuItem) et un `promotionType` (référentiel ci-dessus).
model Promotion {
  id                  String    @id @default(cuid())
  tenantId            String
  menuItemId          String    @unique
  menuItem            MenuItem  @relation("MenuItemPromotion", fields: [menuItemId], references: [id], onDelete: Cascade)
  discountedProductId String?
  discountedProduct   MenuItem? @relation("PromotionDiscountedProduct", fields: [discountedProductId], references: [id], onDelete: SetNull)
  promotionTypeId     String?
  promotionType       PromotionType? @relation(fields: [promotionTypeId], references: [id], onDelete: SetNull)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId])
  @@index([menuItemId])
  @@index([discountedProductId])
  @@index([promotionTypeId])
}

model MenuItemCombo {
  id       String   @id @default(cuid())
  parentId String
  childId  String
  quantity Float
  unit     String?
  cost     Decimal? @db.Decimal(10, 4)

  parent MenuItem @relation("ComboParentToChild", fields: [parentId], references: [id], onDelete: Cascade)
  child  MenuItem @relation("ComboChildToParent", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

/// Association espace↔menu item + prix par espace. UNE ligne = « cet item est vendu dans cet
/// espace » (condition 0 des vues Space Menu) avec, optionnellement, son prix TTC/TVA propres
/// à l'espace (null = fallback MenuItem.basePrice/vatRate). Remplace les champs dénormalisés
/// MenuItem.spaceIds (String[] sans FK) et MenuItem.spacePrices (Json) — gelés en DB, plus lus.
/// Le contrat API expose toujours `spaceIds`/`spacePrices`, sérialisés depuis cette table.
model SpaceMenuItem {
  id         String   @id @default(cuid())
  spaceId    String
  menuItemId String
  priceTtc   Decimal? @db.Decimal(10, 2) // prix TTC spécifique à cet espace (null = basePrice global) ; pour un combo = prix APRÈS promo
  vatRate    Decimal? @db.Decimal(5, 2) // TVA spécifique (null = vatRate item, sinon défaut tenant)
  discountType  String?  // Promo par espace (combo) : "percent" | "amount" | null
  discountValue Decimal? @db.Decimal(10, 2) // Valeur de la promo (% si percent, montant TTC si amount)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, spaceId])
  @@index([spaceId])
}

/// Historique des prix d'un menu item : chaque application du prix Weezevent (ou édition
/// manuelle traçée) archive le prix appliqué avec sa provenance. `MenuItem.basePrice` reste
/// le prix COURANT ; cette table garde la courbe d'évolution dans le temps.
/// `observedAt` = date métier du prix source (ex. transaction Weezevent) ; `createdAt` = pose.
model MenuItemPriceHistory {
  id                 String   @id @default(cuid())
  menuItemId         String
  tenantId           String
  spaceId            String? // espace où ce prix a été appliqué (null = prix global/legacy)
  basePrice          Decimal  @db.Decimal(10, 2) // TTC appliqué
  vatRate            Decimal? @db.Decimal(5, 2)
  currency           String?
  source             String // 'weezevent_catalog' | 'weezevent_sales' | 'manual'
  weezeventProductId String? // produit Weezevent d'où vient le prix (provenance)
  observedAt         DateTime // date du prix source (transaction) ; défaut = pose
  createdAt          DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, createdAt])
  @@index([menuItemId, spaceId, createdAt])
  @@index([tenantId])
}

model MenuItemComponent {
  id            String   @id @default(cuid())
  menuItemId    String
  componentId   String
  numberOfUnits Float
  unitCost      Decimal? @db.Decimal(10, 4)
  totalCost     Decimal? @db.Decimal(12, 4)
  storageType   String?

  menuItem  MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  component MenuComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, componentId])
  @@index([menuItemId])
  @@index([componentId])
}

model MenuItemIngredient {
  id            String   @id @default(cuid())
  menuItemId    String
  ingredientId  String
  numberOfUnits Float
  unitCost      Decimal? @db.Decimal(10, 4)
  totalCost     Decimal? @db.Decimal(12, 4)
  storageType   String?

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
}

model MenuItemPackaging {
  id            String   @id @default(cuid())
  menuItemId    String
  packagingId   String
  numberOfUnits Float
  unitCost      Decimal? @db.Decimal(10, 4)
  totalCost     Decimal? @db.Decimal(12, 4)
  storageType   String?

  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  packaging Packaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, packagingId])
  @@index([menuItemId])
  @@index([packagingId])
}

// ==================== STATIONS & MENU ASSIGNMENTS ====================

model Station {
  id        String   @id // Garder les IDs comme "1761836020929"
  configId  String
  name      String? // Nom optionnel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config Config           @relation(fields: [configId], references: [id], onDelete: Cascade)
  menus  MenuAssignment[]

  @@index([configId])
}

model MenuAssignment {
  id         String   @id @default(cuid())
  stationId  String? // Optional: assignment to a station
  elementId  String? // Optional: assignment to a space element
  // Scope par CONFIGURATION pour les assignations `elementId` : en builder v2 un élément
  // est partagé entre configs (ConfigurationElement), donc « scopé élément » ne suffit plus
  // (un item coché en config A apparaissait en config B). null = assignation station
  // (Station porte déjà son configId) ou élément orphelin sans config adhérente.
  configId   String?
  menuItemId String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  station  Station?      @relation(fields: [stationId], references: [id], onDelete: Cascade)
  element  SpaceElement? @relation(fields: [elementId], references: [id], onDelete: Cascade)
  config   Config?       @relation(fields: [configId], references: [id], onDelete: Cascade)
  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([stationId, menuItemId])
  @@unique([elementId, menuItemId, configId])
  @@index([stationId])
  @@index([elementId])
  @@index([elementId, enabled]) // Composite: shop menu assignment query filters by elementId + enabled
  @@index([menuItemId])
  @@index([configId])
}

// ==================== OUTBOUND WEBHOOKS ====================

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  url       String // Target URL
  secret    String? // HMAC signing secret
  events    String[] // e.g. ["menu_item.created", "menu_item.updated"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   WebhookLog[]

  @@index([tenantId])
  @@index([active])
}

model WebhookLog {
  id        String   @id @default(cuid())
  webhookId String
  event     String // e.g. "menu_item.created"
  payload   Json
  status    Int // HTTP status code of the response
  response  String? // Response body (truncated)
  duration  Int? // Response time in ms
  success   Boolean
  createdAt DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@index([createdAt])
}

// ==================== CSV MAPPINGS ====================

model CsvMapping {
  id          String   @id @default(cuid())
  mappingType String
  mapping     Json
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([mappingType])
}

// ==================== EVENTS (Internal Planning) ====================

// Types d'événements (Concert, Sport Match, Conference...)
model EventType {
  id        String   @id @default(uuid())
  name      String
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories EventCategory[]
  events     Event[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([name])
}

// Catégories d'événements (Show, Ligue 1, Festival...)
model EventCategory {
  id          String   @id @default(uuid())
  name        String
  eventTypeId String
  hasHomeTeam Boolean  @default(false)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventType     EventType          @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  subcategories EventSubcategory[]
  events        Event[]
  teams         Team[]

  @@unique([tenantId, eventTypeId, name])
  @@index([tenantId])
  @@index([eventTypeId])
  @@index([name])
}

// Sous-catégories d'événements (Communautaire, International, Régional...)
model EventSubcategory {
  id              String   @id @default(uuid())
  name            String
  eventCategoryId String
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  eventCategory EventCategory @relation(fields: [eventCategoryId], references: [id], onDelete: Cascade)
  events        Event[]
  teams         Team[]

  @@unique([tenantId, eventCategoryId, name])
  @@index([tenantId])
  @@index([eventCategoryId])
  @@index([name])
}

// Équipes sportives (catalogue tenant, scopé compétition — les deux scopes null = équipe générique)
model Team {
  id                 String   @id @default(uuid())
  name               String
  tenantId           String
  eventCategoryId    String?
  eventSubcategoryId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    EventCategory?    @relation(fields: [eventCategoryId], references: [id])
  subcategory EventSubcategory? @relation(fields: [eventSubcategoryId], references: [id])
  visitingFor Event[]           @relation("EventVisitingTeam")

  // BUG-70 : backstop DB contre la race TOCTOU du check applicatif (createTeam fait un findFirst
  // avant create() ; deux requêtes concurrentes peuvent toutes deux passer le check). Limite
  // connue : Postgres traite NULL comme distinct de NULL — deux équipes "génériques" (les deux
  // scopes null, cf. commentaire du modèle) au même nom ne sont PAS bloquées par cette contrainte,
  // seul le cas scopé catégorie/sous-catégorie l'est. Sensible à la casse (contrairement au check
  // applicatif `mode: 'insensitive'`) — un doublon "France"/"france" passerait encore la
  // contrainte DB ; le check applicatif reste la défense principale pour ce cas, celle-ci n'est
  // qu'un filet de sécurité pour la race exact-match.
  @@unique([tenantId, eventCategoryId, eventSubcategoryId, name])
  @@index([tenantId])
  @@index([eventCategoryId])
  @@index([eventSubcategoryId])
}

// Événements planifiés
model Event {
  id                 String   @id @default(uuid())
  name               String
  eventDate          DateTime
  spaceId            String?
  configurationId    String?
  eventTypeId        String?
  eventCategoryId    String?
  eventSubcategoryId String?
  tenantId           String?

  // BUG-021 : liaison explicite vers l'event Weezevent apparié (au lieu d'un
  // rapprochement par date seule dans les RPC). Rempli automatiquement quand
  // exactement 1 Event et 1 WeezeventEvent partagent tenant+date calendaire ;
  // laissé null en cas d'ambiguïté (plusieurs candidats), à résoudre manuellement
  // via l'API de désambiguïsation.
  // LEGACY depuis integrationId (BUG-368-02, 2026-08-25) : ne sert plus qu'aux tenants
  // pas encore migrés (mode `container-range`, BUG-146-01 — tag du conteneur de saison
  // du club, combiné à la fenêtre). Une fois `integrationId` posé sur un Event, ce champ
  // n'est plus lu par l'agrégation pour lui.
  weezeventEventId String?

  // BUG-368-02 (2026-08-25) : source de vérité explicite de l'intégration/data-integration
  // à laquelle cet Event appartient — remplace la déduction implicite via weezeventEventId
  // (conteneur de saison = proxy du club, BUG-146-01) qui dépendait d'un backfill manuel par
  // tenant. Posé à la création (bulkCreateEvents passe l'intégration sélectionnée). Permet à
  // l'agrégation de matcher directement `WeezeventTransaction.integrationId = Event.
  // integrationId` + fenêtre calendaire, sans jamais regarder `t.eventId` — élimine toute la
  // détection de "conteneur de saison" (span observé/déclaré, cold-start) pour les events qui
  // l'utilisent.
  integrationId String?

  // Event date/time details
  eventStartDate DateTime?
  eventEndDate   DateTime?
  eventEndTime   String?

  // Event details
  location         String?
  spaceName        String?
  sessions         String? // "Open/Show" info
  numberOfSessions Int?
  hasOpeningAct    Boolean?
  hasIntermission  Boolean?

  // Teams (events sport) — home = texte libre, visiting = FK catalogue Team ;
  // visitingTeamName dénormalisé (repli d'affichage si la team est supprimée)
  homeTeamName     String?
  visitingTeamId   String?
  visitingTeamName String?

  // Entertainment (events concert/spectacle) — texte libre, pas de FK catalogue
  performerName  String?
  sponsor        String?
  openingActName String?

  // Attendance
  ticketsSold    Int?
  ticketsScanned Int?

  // Revenue tracking (calculated)
  revenue          Decimal? @db.Decimal(12, 2)
  transactionCount Int?
  avgSpendPerTx    Decimal? @db.Decimal(10, 2)
  perCapita        Decimal? @db.Decimal(10, 2)

  // Status
  status       String? // "success", "pending", etc.
  calculatedAt DateTime?

  // Événement créé par l'outil QA « simuler une vente » (LogisticsService
  // .ensureTodaySalesEvent) et non par un utilisateur : il n'a ni configuration
  // ni type, et sert uniquement à ancrer une vente simulée sur « aujourd'hui ».
  // Exclu d'EventPredict et de l'écran Live (GET /events?excludeSimulated=true),
  // mais VOLONTAIREMENT conservé dans la liste Events pour pouvoir le supprimer
  // à la main. À ne pas confondre avec un événement « ad hoc » (créé quand des
  // transactions arrivent sans événement) : celui-là reste isSimulated=false.
  isSimulated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  space            Space?            @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  configuration    Config?           @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  eventType        EventType?        @relation(fields: [eventTypeId], references: [id])
  eventCategory    EventCategory?    @relation(fields: [eventCategoryId], references: [id])
  eventSubcategory EventSubcategory? @relation(fields: [eventSubcategoryId], references: [id])
  visitingTeam     Team?             @relation("EventVisitingTeam", fields: [visitingTeamId], references: [id])
  weezeventEvent   SalesEvent?       @relation("EventWeezeventEvent", fields: [weezeventEventId], references: [id], onDelete: SetNull)
  integration      Integration?      @relation("EventIntegration", fields: [integrationId], references: [id], onDelete: SetNull)
  staffLines       EventStaffLine[]

  @@index([tenantId])
  @@index([integrationId])
  @@index([spaceId, integrationId])
  @@index([spaceId])
  @@index([configurationId])
  @@index([eventDate])
  @@index([eventTypeId])
  @@index([eventCategoryId])
  @@index([eventSubcategoryId])
  @@index([visitingTeamId])
  @@index([weezeventEventId])
}

// ==================== AUDIT TRAIL ====================

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String // CREATE, UPDATE, DELETE, RESTORE
  entity    String // MenuItem, MenuComponent, etc.
  entityId  String
  changes   Json? // { before: {...}, after: {...} }
  metadata  Json? // Extra context (IP, user-agent, etc.)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity, createdAt])
  @@index([tenantId, entityId])
  @@index([userId])
}

// ==================== MENU (dédié) ====================

model Menu {
  id          String    @id @default(cuid())
  name        String
  description String?
  spaceId     String
  configId    String
  isActive    Boolean   @default(true)
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  space  Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([spaceId, configId, name])
  @@index([tenantId])
  @@index([spaceId])
  @@index([configId])
}

// ==================== SPACE DASHBOARD - MAPPING DOMAIN ====================

// Maps Weezevent Location to Space for revenue attribution
model LocationSpaceMapping {
  id              String   @id @default(cuid())
  tenantId        String
  salesLocationId String   @map("weezeventLocationId")
  spaceId         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, salesLocationId])
  @@index([tenantId, spaceId])
  @@index([salesLocationId])
  @@map("WeezeventLocationSpaceMapping")
}

// Maps Weezevent Merchant to SpaceElement (shop) for revenue grouping
model LocationShopMapping {
  id              String   @id @default(cuid())
  tenantId        String
  salesLocationId String   @map("weezeventLocationId")
  spaceElementId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Intégrité référentielle : le mapping ne peut plus pointer vers un SpaceElement inexistant
  // (cause des « PDV démappés » silencieux). onDelete: Cascade = quand un shop est RÉELLEMENT
  // supprimé (espace/config supprimé), son mapping part avec ; le save de config (reconcile)
  // ne supprime plus jamais un élément mappé, donc aucun mapping légitime n'est perdu.
  spaceElement SpaceElement @relation(fields: [spaceElementId], references: [id], onDelete: Cascade)

  @@unique([tenantId, salesLocationId])
  @@index([tenantId, spaceElementId])
  @@index([salesLocationId])
  @@map("WeezeventLocationShopMapping")
}

// Tenant-specific VAT configuration
model TenantVatConfig {
  id             String   @id @default(cuid())
  tenantId       String
  defaultVatRate Decimal  @db.Decimal(5, 2)
  countryCode    String   @default("FR")
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, effectiveFrom])
  @@index([tenantId])
}

// ==================== SPACE DASHBOARD - READ MODELS ====================

// Minute-level revenue aggregates — source de vérité unique (remplace SpaceRevenueDailyAgg)
// Pour agréger à la journée : GROUP BY DATE_TRUNC('day', minute)
model SpaceRevenueMinuteAgg {
  id       String   @id @default(cuid())
  tenantId String
  spaceId  String
  minute   DateTime // TIMESTAMPTZ tronqué à la minute (ex: 2025-05-10T20:45:00Z)
  timezone String   @default("Europe/Paris")

  // Optional dimensions for filtering
  weezeventEventId    String?
  weezeventLocationId String?
  weezeventMerchantId String?
  spaceElementId      String?
  // Pas dans @@unique : weezeventLocationId/weezeventMerchantId sont déjà des cuid uniques par
  // intégration, l'unicité de la ligne ne dépend pas de ce champ. Sert uniquement à scoper les
  // deleteMany par intégration (BUG-317-02/318-02, docs/bugs/) sans effacer la contribution
  // d'une autre intégration partageant le même Space.
  integrationId String?

  // Aggregated metrics
  revenueHt         Decimal @db.Decimal(12, 2)
  transactionsCount Int
  itemsCount        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, spaceId, minute, weezeventEventId, weezeventLocationId, weezeventMerchantId, spaceElementId])
  @@index([tenantId, spaceId, minute])
  @@index([tenantId, spaceId, weezeventEventId, minute])
  @@index([tenantId, spaceId, spaceElementId, minute])
  @@index([tenantId, spaceId, weezeventLocationId, minute])
  @@index([tenantId, spaceId, integrationId])
}

// Minute-level revenue aggregates WITH product dimension — sert getEventTimelineBatch
// (spaces.service.ts). Grain : event × minute × shop × article. Ne stocke pas
// menuItemId/nom/type/catégorie : résolus à la lecture via WeezeventProductMapping →
// MenuItem → ProductType/ProductCategory, pour rester à jour si les mappings changent
// sans jamais devoir réinvalider l'agrégat (même pattern que get_space_shop_details).
// revenueHt ici NE soustrait PAS la remise, contrairement à SpaceRevenueMinuteAgg
// (BUG-015) — formule alignée sur le comportement historique de getEventTimelineBatch,
// à préserver pour ne pas changer les chiffres déjà affichés sur Analyse/Inventory/Live.
model SpaceRevenueMinuteItemAgg {
  id       String   @id @default(cuid())
  tenantId String
  spaceId  String
  minute   DateTime
  timezone String   @default("Europe/Paris")

  weezeventEventId      String?
  weezeventLocationId   String?
  // Dénormalisé depuis WeezeventTransaction.locationName — seul moyen de reproduire le
  // fallback shopName actuel pour un PdV non mappé (COALESCE(se.name, locationName,
  // locationId)) ; aucun agrégat existant ne le stocke.
  weezeventLocationName String?
  weezeventMerchantId   String?
  spaceElementId        String?
  weezeventProductId    String?
  // Même rôle/même limite que SpaceRevenueMinuteAgg.integrationId ci-dessus (BUG-317-02/318-02) :
  // pas dans @@unique, sert uniquement à scoper les deleteMany par intégration.
  integrationId         String?

  revenueHt         Decimal @db.Decimal(12, 2)
  transactionsCount Int
  itemsCount        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, spaceId, minute, weezeventEventId, weezeventLocationId, weezeventMerchantId, spaceElementId, weezeventProductId])
  @@index([tenantId, spaceId, weezeventEventId, minute])
  @@index([tenantId, spaceId, spaceElementId, minute])
  @@index([tenantId, spaceId, integrationId])
}

// Daily product revenue aggregates
model SpaceProductRevenueDailyAgg {
  id                 String   @id @default(cuid())
  tenantId           String
  spaceId            String
  day                DateTime @db.Date
  weezeventProductId String
  // Même rôle/même limite que SpaceRevenueMinuteAgg.integrationId (BUG-317-02/318-02) : pas dans
  // @@unique (weezeventProductId est déjà unique par intégration), sert uniquement à scoper les
  // deleteMany par intégration.
  integrationId      String?

  // Aggregated metrics
  revenueHt Decimal @db.Decimal(12, 2)
  quantity  Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, spaceId, day, weezeventProductId])
  @@index([tenantId, spaceId, day])
  @@index([tenantId, spaceId, weezeventProductId, day])
  @@index([tenantId, spaceId, integrationId])
}

// Pré-agrégat de la cascade de prix (productId / item_id Weezevent / nom normalisé) — remplace
// le triple raw JOIN de MenuItemPricingService.getLatestSalesPrices*/getModalSalesPrices*
// (17-40s mesurés sur un tenant réel, WeezeventTransactionItem à 3,1M lignes) par une lecture
// indexée sur une table tenue à jour à l'écriture (sync bulk/webhook/Digifood), pas recalculée
// à chaque page vue. BUG-337-02 (docs/bugs/).
//
// productId/itemWeezeventId/productNameNorm sont NON-nullables (sentinel '') plutôt que String? :
// contrairement à SpaceRevenueMinuteAgg (nullable dans @@unique, jamais écrit qu'en delete-puis-
// insert-frais complet), cette table subit des écritures CIBLÉES concurrentes (webhooks quasi
// simultanés) — Postgres traite NULL <> NULL dans un index unique, deux écritures concurrentes sur
// une combinaison "non renseignée" auraient pu créer 2 lignes dupliquées au lieu de fusionner par
// ON CONFLICT. Le sentinel '' rend la clé comparable, l'upsert sûr.
model SalesPriceAgg {
  id            String @id @default(cuid())
  tenantId      String
  integrationId String // dénormalisé (SalesLocation.integrationId) — filtre pratique, pas dans @@unique (déjà déterminé par locationId)
  locationId    String // jamais null : une vente sans location n'est attribuable à aucun espace, non agrégée ici

  productId       String @default("") // SalesProduct.id si résolu, sinon ''
  itemWeezeventId String @default("") // rawData->>'item_id' (Weezevent) / externalItemId (Digifood), quasi toujours renseigné
  productNameNorm String @default("") // LOWER(TRIM(productName)), '' si absent

  unitPrice Decimal @db.Decimal(10, 2)
  vat       Decimal @db.Decimal(5, 2)

  salesCount Int // nb de WeezeventTransactionItem agrégées pour ce (location, clé, prix, tva)
  lastSoldAt DateTime // MAX(transactionDate) des ventes agrégées — "dernier prix"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, locationId, productId, itemWeezeventId, productNameNorm, unitPrice, vat])
  @@index([tenantId, locationId, productId])
  @@index([tenantId, locationId, itemWeezeventId])
  @@index([tenantId, locationId, productNameNorm])
  @@index([tenantId, integrationId])
  @@map("SalesPriceAgg")
}

// Version tracking for cache invalidation
model SpaceDashboardVersion {
  spaceId   String   @id
  tenantId  String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ==================== SPACE DASHBOARD - JOB TRACKING ====================

// Tracks aggregation job execution for monitoring and retry
model AggregationJobLog {
  id                    String    @id @default(cuid())
  tenantId              String
  spaceId               String?
  jobType               String // 'full' | 'incremental' | 'rebuild'
  status                String // 'pending' | 'running' | 'completed' | 'failed'
  fromDate              DateTime  @db.Date
  toDate                DateTime  @db.Date
  transactionsProcessed Int       @default(0)
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  error                 String?   @db.Text
  retryCount            Int       @default(0)
  metadata              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, startedAt])
  @@index([spaceId, status])
  @@index([status, startedAt])
}

// Run de simulation de ventes automatique côté serveur (QA module Live, docs/modules/11_LIVE.md).
// Piloté par un BullMQ Job Scheduler (repeatable, jobSchedulerId = SimulationRun.id, 1:1) — survit
// à la fermeture de l'onglet navigateur. Un tick = une vente simulée sur un PDV/menu item tirés au
// hasard parmi ceux simulables de l'espace (LogisticsService.getSimulableShops), via
// LogisticsService.simulateSale. Au plus un run 'active' par espace : contrôle applicatif dans
// LogisticsService.startSimulationRun, pas de contrainte DB.
model SimulationRun {
  id       String @id @default(cuid())
  tenantId String
  spaceId  String

  intervalMs Int
  realMode   Boolean @default(true)
  configId   String?

  status String @default("active") // 'active' | 'stopped' | 'failed'

  startedByUserId String?
  startedAt       DateTime  @default(now())
  stoppedByUserId String?
  stoppedAt       DateTime?

  tickCount             Int       @default(0)
  errorCount            Int       @default(0)
  consecutiveErrorCount Int       @default(0)
  lastTickAt            DateTime?
  lastTickStatus        String? // 'ok' | 'skipped' | 'error'
  lastTickError         String?   @db.Text
  lastElementId         String?
  lastElementName       String?
  lastTransactionId     String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, spaceId, status])
  @@index([tenantId, status, startedAt])
}

// ==================== INVENTORY ====================

// Horodated snapshot of the full inventoryCounts JSON (one per POST /inventory call)
model InventorySnapshot {
  id              String   @id @default(cuid())
  tenantId        String
  spaceId         String
  eventId         String?
  // Phase du comptage pour cet event. null = legacy (avant Pre-event Inventory) ;
  // 'post-event' = compté après le match ; 'pre-event' = compté avant. Ferme le
  // cycle : le « pré-event » de la réconciliation post-event = dernier snapshot
  // kind='pre-event' du MÊME event. Migration :
  // prisma/sql/2026-07-20_inventorysnapshot_kind.sql
  kind            String?
  inventoryCounts Json
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([spaceId, eventId])
  @@index([spaceId, createdAt])
}

// Per-item count upserted by POST /inventory-counts (one row per space+event+shop+item)
model InventoryCount {
  id                String   @id @default(cuid())
  tenantId          String
  spaceId           String
  eventId           String?
  shopId            String?
  itemId            String
  packedUnits       Int      @default(0)
  looseUnits        Float    @default(0)
  isCounted         Boolean  @default(false)
  storageLocation   String?
  countingStatus    String   @default("pending")
  discardedQuantity Int      @default(0)
  discardedReason   String?
  countedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, spaceId, eventId, shopId, itemId], name: "uniq_inventory_count")
  @@index([tenantId])
  @@index([spaceId, eventId])
  @@index([shopId])
  @@index([itemId])
  // Couvre getLatestBySpace : findFirst({ where: { tenantId, spaceId }, orderBy: { updatedAt: desc } })
  // — sans lui : scan + tri par appel (cf. inventory.service.ts).
  @@index([tenantId, spaceId, updatedAt(sort: Desc)])
}

// ==================== LOGISTICS (stock movements ledger) ====================

enum StockMovementReason {
  DELIVERY // ajout par livraison (défaut)
  TRANSFER_SHOP // transfert depuis/vers un PDV (counterpartyElementId)
  TRANSFER_STORAGE // transfert depuis/vers un storage (counterpartyElementId)
  EXPIRY // date limite de consommation (expiryDate)
  SALE // réservé : matérialisation future des ventes par job
  INVENTORY_RESET // ajustement posé par le reset post-inventaire
  OTHER // raison libre (note)
}

// BUG-259-02 (2026-08-13) : statut d'un transfert (TRANSFER_SHOP/TRANSFER_STORAGE
// uniquement — null pour toute autre raison). PENDING = émis côté source, en
// attente de confirmation par la contrepartie ; CONFIRMED = confirmé (avec ou
// sans écart de quantité).
enum StockTransferStatus {
  PENDING
  CONFIRMED
}

// Ledger append-only des mouvements de stock. Deltas SIGNÉS (positif = entrée,
// négatif = sortie). BUG-259-02 : un transfert ne crée plus qu'UNE ligne à
// l'émission (source négative, status=PENDING) ; la ligne miroir (cible positive,
// status=CONFIRMED) n'est créée qu'à la confirmation par la contrepartie
// (`confirmTransfer`), les deux liées par transferGroupId. Source de vérité de
// l'historique Logistic.
model StockMovement {
  id                    String               @id @default(cuid())
  tenantId              String
  spaceId               String
  elementId             String // PDV ou storage (SpaceElement)
  itemKey               String // même référence que l'inventaire dérivé (nom)
  // Identité stable en remplacement progressif d'itemKey (ADR-0006) — polymorphe car un article
  // est la vérité de l'une de 5 tables différentes (MarketPrice/Ingredient/Packaging/MenuItem/
  // MenuComponent), sans FK Prisma unique possible. Nullable : double-écriture en cours, itemKey
  // reste la clé effective tant que la bascule des lectures n'est pas faite (chantier 377).
  itemKind              String? // 'marketPrice' | 'ingredient' | 'packaging' | 'menuItem' | 'menuComponent'
  itemRefId             String?
  menuItemId            String?
  marketPriceId         String?
  packedDelta           Int                  @default(0)
  looseDelta            Float                @default(0)
  reason                StockMovementReason
  counterpartyElementId String? // PDV/storage source ou destination (TRANSFER_*)
  transferGroupId       String?
  status                StockTransferStatus? // TRANSFER_* uniquement, cf. StockTransferStatus
  confirmedAt           DateTime? // date de confirmation (transferts)
  confirmedBy           String? // userId ayant confirmé (transferts)
  expiryDate            DateTime? // EXPIRY
  note                  String? // OTHER (ou commentaire libre)
  eventId               String? // SALE / INVENTORY_RESET
  createdBy             String?
  createdAt             DateTime             @default(now())

  marketPrice MarketPrice? @relation(fields: [marketPriceId], references: [id], onDelete: SetNull)

  @@index([tenantId, elementId, createdAt])
  @@index([tenantId, spaceId, createdAt])
  @@index([itemRefId])
  @@index([tenantId, spaceId, eventId])
  @@index([tenantId, counterpartyElementId, status])
  @@index([marketPriceId])
}

// État courant matérialisé du stock attendu par élément × item (packed/loose).
// Mis à jour transactionnellement avec chaque StockMovement. Les ventes ne sont
// PAS incluses ici : elles sont dérivées read-time depuis la dernière réconciliation.
model StockLevel {
  id            String   @id @default(cuid())
  tenantId      String
  spaceId       String
  elementId     String
  itemKey       String
  // Identité stable en remplacement progressif d'itemKey (ADR-0006) — voir StockMovement.
  itemKind      String? // 'marketPrice' | 'ingredient' | 'packaging' | 'menuItem' | 'menuComponent'
  itemRefId     String?
  packedUnits   Int      @default(0)
  looseUnits    Float    @default(0)
  unitsPerPack  Float? // MarketPrice.numberOfUnits du dernier ajout (casse de pack)
  marketPriceId String? // dernier market price utilisé
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  marketPrice MarketPrice? @relation(fields: [marketPriceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, elementId, itemKey], name: "uniq_stock_level")
  // ADR-0006 (chantier 377, étape 5) : deuxième contrainte, basée sur l'identité stable — les
  // deux coexistent tant qu'itemKey reste la clé effective de la double-écriture. Postgres ne
  // considère jamais deux NULL comme égaux dans un index unique standard : les lignes orphelines
  // (itemRefId null) ne collisionnent jamais entre elles, seule une VRAIE identité dupliquée
  // (même élément, même article) est bloquée.
  @@unique([tenantId, elementId, itemRefId], name: "uniq_stock_level_by_ref")
  @@index([tenantId, spaceId])
  @@index([marketPriceId])
}

// Archive des écarts attendu vs compté figée par un Inventory Reset.
// `lines` = [{ elementId, elementName, itemKey, expectedPacked, expectedLoose,
//   countedPacked, countedLoose, deltaUnits }]. Le "fichier" de réconciliation
// est exporté à la volée depuis ce JSON. La plus récente sert d'ancre temporelle
// à la dérivation des ventes.
model StockReconciliation {
  id        String   @id @default(cuid())
  tenantId  String
  spaceId   String
  eventId   String?
  eventName String?
  // Origine du document. null = reset logistique historique (ancre des ventes
  // dérivées) ; 'post-event' = document généré par Post-event Inventory à la
  // sauvegarde du comptage (lignes enrichies sold/pred/left/missing, ne touche
  // PAS aux StockLevel). Migration : prisma/sql/2026-07-20_stockreconciliation_kind_post_event.sql
  kind      String?
  lines     Json
  // Contexte de fabrication du document (BUG-238/241, 2026-07-24) : provenance du
  // stock de départ (`preEventSource`), ventes non rattachées écartées du calcul
  // (`salesUnjoined`), lignes orphelines exclues (`orphanLinesExcluded`). Un
  // document est une photo figée : sans ces marqueurs, un écart fabriqué par une
  // source manquante est indiscernable d'un vrai manquant.
  // Migration : prisma/sql/2026-07-24_stockreconciliation_meta.sql
  meta      Json?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([tenantId, spaceId, createdAt])
}

// BUG-259-02 (2026-08-13) : perte constatée à la confirmation d'un transfert
// (quantité confirmée < quantité déclarée à l'émission). Table dédiée, distincte
// de StockReconciliation (qui modélise un écart de COMPTAGE, pas un écart de
// TRANSFERT ; champs explicites source/destination plutôt qu'un `lines` Json
// générique). `archivedAt` = "vidée" par un utilisateur : jamais supprimée (piste
// d'audit), seulement masquée de la liste active par défaut.
model StockTransferLoss {
  id                   String    @id @default(cuid())
  tenantId             String
  spaceId              String
  itemKey              String
  // Identité stable en remplacement progressif d'itemKey (ADR-0006) — voir StockMovement.
  itemKind             String? // 'marketPrice' | 'ingredient' | 'packaging' | 'menuItem' | 'menuComponent'
  itemRefId            String?
  sourceElementId      String
  destinationElementId String
  unitsPerPack         Float?
  declaredPacked       Int       @default(0)
  declaredLoose        Float     @default(0)
  receivedPacked       Int       @default(0)
  receivedLoose        Float     @default(0)
  lostPacked           Int       @default(0)
  lostLoose            Float     @default(0)
  transferMovementId   String? // StockMovement source (transferGroupId) d'origine
  archivedAt           DateTime?
  archivedBy           String?
  createdBy            String?
  createdAt            DateTime  @default(now())

  @@index([tenantId, spaceId, createdAt])
  @@index([tenantId, spaceId, archivedAt])
  @@index([itemRefId])
}

// ==================== KV STORE ====================

// Generic key-value store (Event Predict versions, etc.)
model KvStore {
  id        String   @id @default(cuid())
  key       String
  tenantId  String?
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key], name: "uniq_kv_store")
  @@index([tenantId])
}

// ==================== EVENT PREDICT VERSIONS ====================

model EventPredictVersion {
  id                         String   @id @default(cuid())
  tenantId                   String?
  eventId                    String
  spaceId                    String?
  name                       String
  isDefault                  Boolean  @default(false)
  eventSnapshot              Json
  totalRevenue               Float    @default(0)
  adjustedTotalRevenue       Float    @default(0)
  perCapita                  Float    @default(0)
  adjustedPerCapita          Float    @default(0)
  menuConfig                 Json
  quantityAdjustments        Json
  manualQuantities           Json     @default("{}")
  predictedRecords           Json     @default("[]")
  selectedPredictionEventIds String[]
  selectedTimeRange          Json?
  createdBy                  String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([tenantId])
  @@index([eventId])
  @@index([spaceId])
  // Couvre findAll : where { eventId, tenantId } (cf. predict-versions.service.ts)
  @@index([tenantId, eventId])
}

// ==================== MENU ITEM HISTORY ALIASES ====================

// Alias « historique emprunté » (Event Predict, maquettes 08/2026) : un nouvel
// article (target) reprend l'historique de ventes d'un ancien (source) pour
// obtenir des prévisions. Résolution 100 % FRONTEND (activeTimelineData
// d'EventPredictView) : la page Analyse ne lit JAMAIS cette table — aucune
// jointure côté analyse.service/spaces.service (contrainte métier).
// `sourceName` = nom brut de l'item timeline (les items historiques peuvent
// être synthétiques, sans id catalogue) ; `sourceMenuItemId` optionnel quand
// il existe. Unicité (tenant, space, sourceName) : un historique source ne
// nourrit qu'une seule cible (upsert = re-mapper). Sans FK, comme
// EventPredictVersion / RestockState (zone KV de ce schéma).
model MenuItemHistoryAlias {
  id               String   @id @default(cuid())
  tenantId         String
  spaceId          String
  sourceMenuItemId String?
  sourceName       String
  targetMenuItemId String
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, spaceId, sourceName])
  @@index([tenantId, spaceId])
  @@index([targetMenuItemId])
}

// ==================== RESTOCK STATE ====================

// Unique restock session state per (tenantId, spaceId) — upsert idempotent.
// Persists the 9-field UI snapshot from SpaceRestockView so users can resume
// on another machine without losing their selections, adjustments and confirmations.
model RestockState {
  id        String   @id @default(cuid())
  tenantId  String
  spaceId   String
  state     Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, spaceId])
  @@index([tenantId])
  @@index([spaceId])
}

// ==================== RESTOCK PLANS ====================

// Plan de réarmement NOMMÉ, scope ESPACE (un plan couvre N events : le
// réarmement travaille sur selectedEventIds pluriel). Contrairement à
// RestockState (1 ligne écrasée = session courante), un plan est un DOCUMENT
// FIGÉ : stockLines / restockLines / shoppingGroups sont la PHOTO des lignes
// calculées au moment de la sauvegarde. Rouvrir un plan ancien réaffiche
// EXACTEMENT les mêmes chiffres même si prédictions, prix ou recettes ont
// changé depuis — même famille que StockReconciliation, mais ÉDITABLE.
// Un plan n'est PAS une source de stock (même avertissement que RestockState).
// Migration : prisma/migrations/20260804170000_add_restockplan/
// Décision : docs/adr/0005_restockplan_document_fige_vs_restockstate_session.md
model RestockPlan {
  id       String @id @default(cuid())
  tenantId String
  spaceId  String
  name     String

  // ── Entrées (rejouées au détachement du plan) ────────────────────────────
  objectiveSource   String  @default("forecast")
  referenceEventId  String?
  selectedEventIds  String[]
  // [{ id, name, date }] dénormalisé : un event supprimé ou renommé ne doit pas
  // effacer l'intitulé du plan (même raison que StockReconciliation.eventName).
  eventsSnapshot    Json    @default("[]")
  scenarioByEventId Json    @default("{}")
  stockAdjustments  Json    @default("{}")
  stockPackedModes  Json    @default("{}")
  stockExcluded     Json    @default("{}")
  restockedRows     Json    @default("{}")

  // ── Photo figée (sorties des 3 étapes) ───────────────────────────────────
  stockLines     Json   @default("[]") // étape 1, grain article
  restockLines   Json   @default("[]") // étape 2, grain shop × article
  shoppingMode   String @default("finished")
  shoppingGroups Json   @default("[]") // étape 3, grain fournisseur
  // Coefficients d'explosion recette FIGÉS : permettent de recalculer la feuille
  // de course quand l'utilisateur corrige une quantité, SANS relire le catalogue
  // vivant (qui a pu changer depuis la photo).
  recipeCoeffs   Json   @default("{}")
  // Corrections manuelles appliquées PAR-DESSUS restockLines (rowKey → quantité).
  // Séparées des lignes pour que « calculé » et « corrigé à la main » restent
  // distinguables à la relecture d'un vieux plan.
  lineOverrides  Json   @default("{}")

  // Compteurs dénormalisés (au moment de la photo) → la liste s'affiche sans
  // jamais lire les blobs.
  lineCount         Int @default(0)
  shoppingItemCount Int @default(0)

  // Contexte de fabrication (parité StockReconciliation.meta) : snapshotAt,
  // unmatchedStorage, dégradations connues au moment de la photo.
  meta Json?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Couvre la liste : where { tenantId, spaceId } orderBy updatedAt desc.
  @@index([tenantId, spaceId, updatedAt])
  @@index([spaceId])
}

// Tracks unmapped Weezevent entities for data quality monitoring
model UnmappedDataMetrics {
  id               String   @id @default(cuid())
  tenantId         String
  entityType       String // 'location' | 'merchant' | 'product'
  entityId         String
  entityName       String
  transactionCount Int      @default(0)
  revenueHt        Decimal  @db.Decimal(12, 2)
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @updatedAt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, entityType])
  @@index([lastSeenAt])
}
