// Datasource Supabase Postgres
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  // driverAdapters : requêtes via node-postgres (prepared statements NON nommés),
  // compatibles pooler transaction (6543) SANS le wrapping BEGIN/DEALLOCATE ALL/COMMIT
  // que pgbouncer=true impose au moteur natif (~3 round-trips perdus par requête).
  previewFeatures = ["driverAdapters"]
}

