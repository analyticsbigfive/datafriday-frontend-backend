// ==================== MENU ITEMS ====================

model MenuItem {
  id                     String        @id @default(cuid())
  name                   String
  typeId                 String? // FK to ProductType (optional)
  categoryId             String? // FK to ProductCategory (optional)
  brandId                String? // FK to Brand (optional)
  displayNameId          String? // FK to DisplayName (optional)
  diet                   Diet[]
  allergens              String[]
  picture                String?
  basePrice              Decimal       @db.Decimal(10, 2)
  vatRate                Decimal?      @db.Decimal(5, 2) // Taux TVA % par article (null → défaut tenant)
  discountType           String? // Remise catalogue : "percent" | "amount" | null
  discountValue          Decimal?      @db.Decimal(10, 2) // Valeur remise (% si percent, montant TTC si amount)
  totalCost              Decimal?      @db.Decimal(12, 4)
  margin                 Float?
  description            String?
  storageType            StorageType[]
  readyForSale           String? // "Yes", "No" ou null
  kitchenType            KitchenType? // Cuisine Centrale/Locale, saisi quand readyForSale = "Yes"
  comboItem              String? // "Yes", "No" ou null
  numberOfPiecesRecipe   Int?
  componentsData         Json? // Pour stocker les components JSON de Figma
  inventoryPackagingType String? // Type de conditionnement inventaire (ex: Box, Bag)
  inventoryNumberOfUnits Float? // Nombre d'unités par conditionnement
  inventoryUnit          String? // Unité du conditionnement inventaire (ex: Kg, L, Pc)
  // ⚠️ spaceIds (String[]) et spacePrices (Json) existent encore en DB mais sont GELÉS
  // (source de vérité = table SpaceMenuItem, cf. modèle plus bas). Retirés du schéma pour
  // que tout code qui les référencerait encore casse à la compilation. Drop DB différé
  // (migration de nettoyage après validation).
  tenantId               String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productType     ProductType?           @relation(fields: [typeId], references: [id])
  productCategory ProductCategory?       @relation(fields: [categoryId], references: [id])
  brand           Brand?                 @relation(fields: [brandId], references: [id])
  displayName     DisplayName?           @relation(fields: [displayNameId], references: [id])
  components      MenuItemComponent[]
  ingredients     MenuItemIngredient[]
  packagings      MenuItemPackaging[]
  menuAssignments MenuAssignment[]
  salesMappings   ProductMapping[]
  priceHistory    MenuItemPriceHistory[]
  spaceLinks      SpaceMenuItem[]

  @@index([tenantId])
  @@index([name])
  @@index([typeId])
  @@index([categoryId])
  @@index([brandId])
  @@index([displayNameId])
  @@index([readyForSale])
  @@index([tenantId, deletedAt])
}

/// Association espace↔menu item + prix par espace. UNE ligne = « cet item est vendu dans cet
/// espace » (condition 0 des vues Space Menu) avec, optionnellement, son prix TTC/TVA propres
/// à l'espace (null = fallback MenuItem.basePrice/vatRate). Remplace les champs dénormalisés
/// MenuItem.spaceIds (String[] sans FK) et MenuItem.spacePrices (Json) — gelés en DB, plus lus.
/// Le contrat API expose toujours `spaceIds`/`spacePrices`, sérialisés depuis cette table.
model SpaceMenuItem {
  id         String   @id @default(cuid())
  spaceId    String
  menuItemId String
  priceTtc   Decimal? @db.Decimal(10, 2) // prix TTC spécifique à cet espace (null = basePrice global)
  vatRate    Decimal? @db.Decimal(5, 2) // TVA spécifique (null = vatRate item, sinon défaut tenant)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, spaceId])
  @@index([spaceId])
}

/// Historique des prix d'un menu item : chaque application du prix Weezevent (ou édition
/// manuelle traçée) archive le prix appliqué avec sa provenance. `MenuItem.basePrice` reste
/// le prix COURANT ; cette table garde la courbe d'évolution dans le temps.
/// `observedAt` = date métier du prix source (ex. transaction Weezevent) ; `createdAt` = pose.
model MenuItemPriceHistory {
  id                 String   @id @default(cuid())
  menuItemId         String
  tenantId           String
  spaceId            String? // espace où ce prix a été appliqué (null = prix global/legacy)
  basePrice          Decimal  @db.Decimal(10, 2) // TTC appliqué
  vatRate            Decimal? @db.Decimal(5, 2)
  currency           String?
  source             String // 'weezevent_catalog' | 'weezevent_sales' | 'manual'
  weezeventProductId String? // produit Weezevent d'où vient le prix (provenance)
  observedAt         DateTime // date du prix source (transaction) ; défaut = pose
  createdAt          DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, createdAt])
  @@index([menuItemId, spaceId, createdAt])
  @@index([tenantId])
}

model MenuItemComponent {
  id            String       @id @default(cuid())
  menuItemId    String
  componentId   String
  numberOfUnits Float
  unitCost      Decimal?     @db.Decimal(10, 4)
  totalCost     Decimal?     @db.Decimal(12, 4)
  storageType   StorageType?

  menuItem  MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  component MenuComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, componentId])
  @@index([menuItemId])
  @@index([componentId])
}

model MenuItemIngredient {
  id            String       @id @default(cuid())
  menuItemId    String
  ingredientId  String
  numberOfUnits Float
  unitCost      Decimal?     @db.Decimal(10, 4)
  totalCost     Decimal?     @db.Decimal(12, 4)
  storageType   StorageType?

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

