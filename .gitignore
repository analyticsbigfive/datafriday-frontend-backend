# Fichiers d'environnement (secrets) — ne JAMAIS committer.
# NB : frontend/.gitignore couvre déjà frontend/.env* ; ce fichier-ci couvre la
# racine du monorepo (.env, .env.development, .env.production, .env.staging…).
.env
.env.*
!.env.example

# macOS
.DS_Store

# Artefacts de mesure locaux (HAR Chrome, rapports Lighthouse, logs Render copiés)
# — jamais à committer, ils partiraient dans un `git add -A`.
*.har
frontend/lighthouse/
frontend/logsRender.md
