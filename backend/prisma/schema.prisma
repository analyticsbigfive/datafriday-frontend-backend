// ==================== MULTI-TENANT ====================

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  domain String?      @unique
  logo   String?
  plan   TenantPlan   @default(FREE)
  status TenantStatus @default(ACTIVE)

  // Invitation System
  invitationCode    String? @unique // Code for joining this tenant
  invitationEnabled Boolean @default(true) // Allow new members to join

  // Business Information
  organizationType String? // Restaurant, Hotel, Bar, Event, etc.
  siret            String?
  address          String?
  city             String?
  postalCode       String?
  country          String? @default("France")
  email            String?
  phone            String?

  // Additional Info
  numberOfEmployees Int?
  numberOfSpaces    Int?
  paymentMethod     String? // Card, Transfer, Direct Debit, etc.

  metadata Json?

  // Weezevent Integration
  weezeventClientId       String?
  weezeventClientSecret   String? // Encrypted
  weezeventOrganizationId String? // Weezevent Organization ID
  weezeventEnabled        Boolean @default(false)

  // Weezevent Webhook
  weezeventWebhookSecret  String? // Secret for signature validation
  weezeventWebhookEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users       User[] // Keep for backward compatibility
  userTenants UserTenant[] // New many-to-many relation
  spaces      Space[]
  suppliers   Supplier[]

  // RBAC (rôles/permissions dynamiques)
  roles       Role[]
  permissions Permission[] // Permissions custom du tenant (scope CUSTOM)

  // Menu domain relations (ajoutées pour isolation multi-tenant)
  menuItems            MenuItem[]
  menuItemPriceHistory MenuItemPriceHistory[]
  menuComponents       MenuComponent[]
  ingredients          Ingredient[]
  packagings           Packaging[]
  marketPrices         MarketPrice[]
  csvMappings          CsvMapping[]
  menus                Menu[]
  auditLogs            AuditLog[]
  webhooks             Webhook[]

  // Events domain
  teams Team[]

  // Weezevent Relations
  salesEvents              SalesEvent[]
  weezeventMerchants       WeezeventMerchant[]
  salesLocations           SalesLocation[]
  salesProducts            SalesProduct[]
  weezeventUsers           WeezeventUser[]
  weezeventWallets         WeezeventWallet[]
  salesTransactions        SalesTransaction[]
  integrationWebhookEvents IntegrationWebhookEvent[]
  productMappings          ProductMapping[]
  salesProductVariants     SalesProductVariant[]
  salesProductComponents   SalesProductComponent[]
  weezeventOrders          WeezeventOrder[]
  weezeventPrices          WeezeventPrice[]
  weezeventAttendees       WeezeventAttendee[]
  integrations             Integration[]

  @@index([slug])
  @@index([status])
  @@index([weezeventEnabled])
  @@index([weezeventWebhookEnabled])
}

// Provenance des intégrations et des données de ventes (PLAN_INTEGRATION_DIGIFOOD §2.1)
enum IntegrationProvider {
  WEEZEVENT
  DIGIFOOD
}

// Intégration de ventes (multi-provider). Table physique historique "Integration",
// détail des credentials dans une table 1-1 par provider (WeezeventIntegrationConfig /
// DigifoodIntegrationConfig). Voir PLAN_INTEGRATION_DIGIFOOD §2.2.
// ⚠️ clientId/clientSecret/organizationId : colonnes gelées, à retirer du modèle au
// refactor de renommage (étape 2 du plan) — lecture/écriture via WeezeventIntegrationConfig.
model Integration {
  id        String              @id @default(cuid())
  tenantId  String
  provider  IntegrationProvider @default(WEEZEVENT)
  name      String // User-defined label, e.g. "Stande", "Hellfest 2025"
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Détail de config 1-1 selon provider
  weezevent WeezeventIntegrationConfig?
  digifood  DigifoodIntegrationConfig?

  // Back-references
  events            SalesEvent[]
  merchants         WeezeventMerchant[]
  locations         SalesLocation[]
  products          SalesProduct[]
  users             WeezeventUser[]
  wallets           WeezeventWallet[]
  transactions      SalesTransaction[]
  orders            WeezeventOrder[]
  prices            WeezeventPrice[]
  attendees         WeezeventAttendee[]
  productVariants   SalesProductVariant[]
  productComponents SalesProductComponent[]
  syncStates        WeezeventSyncState[]
  webhookEvents     IntegrationWebhookEvent[]
  syncJobs          WeezeventSyncJob[]
  csvImportRuns     DigifoodCsvImportRun[]
  // BUG-368-02 : Event DataFriday déclarant explicitement cette intégration comme sa source.
  dfEvents          Event[]                  @relation("EventIntegration")

  @@index([tenantId])
  @@index([tenantId, enabled])
  @@index([tenantId, provider, enabled])
  @@map("WeezeventIntegration")
}

// Credentials API Weezevent — détail 1-1 de Integration (provider = WEEZEVENT)
model WeezeventIntegrationConfig {
  id             String  @id @default(cuid())
  integrationId  String  @unique
  clientId       String
  clientSecret   String // Encrypted (EncryptionService)
  organizationId String? // Weezevent Organization ID

  // BUG-106 : secret de signature webhook par intégration (au lieu du seul
  // Tenant.weezeventWebhookSecret global). Repli sur les colonnes tenant si absent.
  webhookSecret  String? // Encrypted (EncryptionService)
  webhookEnabled Boolean?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

// Secret webhook Digifood — détail 1-1 de Integration (provider = DIGIFOOD)
model DigifoodIntegrationConfig {
  id            String  @id @default(cuid())
  integrationId String  @unique
  webhookSecret String // Encrypted (EncryptionService)
  keyVersion    String? // Dernière valeur reçue de digifood-wh-key-version
  posVersion    String? // Info : "24" | "26" (détectée via software.version)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

// ==================== USER & AUTH ====================

model User {
  id        String  @id @default(cuid())
  email     String
  firstName String
  lastName  String
  fullName  String?
  phone     String? // Téléphone de contact (optionnel)

  role            UserRole @default(VIEWER) // Legacy - conservé pour compatibilité, voir roleRef
  roleId          String? // RBAC dynamique - FK vers Role (nullable pendant la transition)
  avatar          String?
  // Super-admin PLATEFORME (DataFriday), distinct du rôle ADMIN d'une organisation.
  // Donne accès à l'administration cross-tenant (SuperAdminGuard). Écriture réservée
  // à un super-admin existant / bootstrap via script. Voir docs/CONCEPTION_CIBLE_AUTH.md §3.
  isSuperAdmin    Boolean  @default(false)
  // Accès à TOUS les espaces de l'organisation (présents et futurs), INDÉPENDAMMENT du rôle.
  // Choisi par l'owner à la création/édition. L'owner et le super-admin voient toujours tout.
  // Voir docs/CONCEPTION_CIBLE_AUTH.md §5 (accès par espace découplé du rôle).
  allSpacesAccess Boolean  @default(false)
  tenantId        String // Keep for backward compatibility
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef      Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  userTenants  UserTenant[] // New many-to-many relation
  pinnedSpaces UserPinnedSpace[]
  spaceAccess  UserSpaceAccess[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([email])
  @@index([roleId])
}

// Many-to-many relation between User and Tenant
model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      UserRole @default(ADMIN) // Legacy - conservé pour compatibilité, voir roleRef
  roleId    String? // RBAC dynamique - FK vers Role (nullable pendant la transition)
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleRef Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([isOwner])
  @@index([roleId])
}

model UserPinnedSpace {
  id       String   @id @default(cuid())
  userId   String
  spaceId  String
  pinnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([userId])
}

model UserSpaceAccess {
  id        String   @id @default(cuid())
  userId    String
  spaceId   String
  role      UserRole @default(VIEWER)
  grantedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([userId])
  @@index([spaceId])
}

// ==================== RBAC (Rôles & Permissions dynamiques) ====================
// Voir docs/auth/RBAC_SYSTEM.md pour le design complet.

// Origine d'une permission :
// - SYSTEM : fait partie du catalogue système (tenantId = null), non éditable
// - CUSTOM : créée par un tenant (tenantId = <tenant>), éditable par les admins du tenant
enum PermissionScope {
  SYSTEM
  CUSTOM
}

model Permission {
  id          String          @id @default(cuid())
  tenantId    String? // null = permission système globale (catalogue partagé)
  code        String // ex: "nav.spaces", "org.roles.manage" (unicité gérée par seed/service, voir doc)
  name        String
  description String?
  category    String? // regroupement pour l'UI (ex: "Navigation", "Organisation")
  scope       PermissionScope @default(CUSTOM)
  isSystem    Boolean         @default(false) // true = non modifiable/supprimable via l'UI
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles  RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([scope])
}

model Role {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  // Référence vers le rôle "système" équivalent (ADMIN/MANAGER/STAFF/VIEWER) pour la
  // hiérarchie legacy et la règle "ADMIN = toutes les permissions". Null pour les rôles
  // 100% custom créés par un tenant.
  systemKey   UserRole?
  isSystem    Boolean   @default(false) // true = rôle cloné depuis le catalogue système (non supprimable)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]
  userTenants UserTenant[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([systemKey])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ==================== SPACE & CONFIG ====================

model Space {
  id        String   @id @default(cuid())
  name      String
  image     String?  @db.Text
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Contact Info
  tel               String?
  email             String?
  contactTel        String?
  contactEmail      String?
  mainContactPerson String?

  // Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  department   Int?
  country      String?

  // Space Details
  spaceType      String? // Stadium, Arena, etc.
  spaceTypeOther String?
  maxCapacity    Int?
  homeTeam       String?

  // Social Media
  facebook  String?
  instagram String?
  twitter   String?
  tiktok    String?

  // Metrics (calculated/cached)
  avgEvent       Float?
  avgTransaction Float?
  perCapita      Float?
  cachedMetrics  Json? // Cache des métriques calculées

  // Timezone for dashboard aggregations
  timezone String? @default("Europe/Paris")

  // Relations
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configs       Config[]
  zones         Zone[] // Builder v2
  pinnedByUsers UserPinnedSpace[]
  userAccess    UserSpaceAccess[]
  menus         Menu[]
  menuItemLinks SpaceMenuItem[]
  events        Event[]

  // Settings HR (paramétrage Goals / Staff par Responsable de zone)
  hrGoalSpaces       HrGoalSpace[]
  hrStaffRatioSpaces HrStaffRatioSpace[]

  // Rapport Saison : périodes personnalisées (custom ranges) rattachées à cet espace
  seasonSpaces SeasonSpace[]

  // Staffing RH : agence par défaut de l'espace pour un rôle donné
  hrRoleSpaceDefaults HrRoleSpaceDefault[]

  // Staffing RH : associations Rôle ↔ Menu Item(s) scopées à cet espace (11_RH_STAFFING.md §11.16)
  hrRoleMenuItemRatios HrRoleMenuItemRatio[]

  @@index([tenantId])
  @@index([name])
  @@index([spaceType])
  @@index([city])
}

// ─────────────────────────────────────────────────────────────────────────────
// Settings HR — 2 variables paramétrables, chacune rattachée à un ENSEMBLE de
// Spaces (ou à tous via allSpaces). Une ligne par ensemble d'espaces (demande
// Bertrand 2026-07-28). tenantId scalaire requis → auto-scopé par PrismaService.
// Le « ALL » est porté par allSpaces=true (jointure vide), pas par une sentinelle.
// ─────────────────────────────────────────────────────────────────────────────

/// Objectif de CA par TPE (devise), rattaché à un ensemble de Spaces.
model HrGoal {
  id         String   @id @default(cuid())
  tenantId   String
  goalPerTpe Float
  allSpaces  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  spaces HrGoalSpace[]

  @@index([tenantId])
}

model HrGoalSpace {
  goalId  String
  spaceId String

  goal  HrGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  space Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([goalId, spaceId])
  @@index([goalId])
  @@index([spaceId])
}

/// Nombre de staff par Responsable de zone (entier), rattaché à un ensemble de Spaces.
model HrStaffRatio {
  id                  String   @id @default(cuid())
  tenantId            String
  staffPerZoneManager Int
  allSpaces           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  spaces HrStaffRatioSpace[]

  @@index([tenantId])
}

model HrStaffRatioSpace {
  ratioId String
  spaceId String

  ratio HrStaffRatio @relation(fields: [ratioId], references: [id], onDelete: Cascade)
  space Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([ratioId, spaceId])
  @@index([ratioId])
  @@index([spaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Rapport Saison — périodes personnalisées (« Saison 2025-2026 », 1er juil →
// 30 juin) paramétrées dans Settings > Configuration, rattachées à un ensemble
// de Spaces (ou à tous via allSpaces) et proposées comme presets de dates dans
// Analyse et Predict. Même schéma de rattachement que HrGoal (jointure
// explicite, jamais de spaceIds JSON — ADR-0003). Contrairement aux Settings
// HR, les saisons PEUVENT se chevaucher sur un même espace (2024-25 et 2025-26
// coexistent) : aucune règle d'unicité.
// ─────────────────────────────────────────────────────────────────────────────

/// Période personnalisée nommée (dates absolues), rattachée à un ensemble de Spaces.
model Season {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  allSpaces Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaces    SeasonSpace[]
  menuItems MenuItem[]

  @@index([tenantId])
}

model SeasonSpace {
  seasonId String
  spaceId  String

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  space  Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([seasonId, spaceId])
  @@index([seasonId])
  @@index([spaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Staffing RH (feat/Hr, 2026-07-29) — fournisseurs RH, rôles métier, personnes
// internes, agence par défaut par espace, lignes de staff par événement × PDV.
// Migre hr_suppliers / staff_positions du localStorage (frontend utils/hrApi.js).
// tenantId scalaire → auto-scopé par PrismaService (même patron que HrGoal).
// ⚠️ AUCUN rapport avec `Role` (permissions utilisateurs, features/roles/).
// ─────────────────────────────────────────────────────────────────────────────

/// Fournisseur RH (agence d'intérim, prestataire staff…).
model HrSupplier {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  contact     String? // nom du contact
  email       String?
  tel         String?
  picture     String?  @db.Text // parité avec le drawer existant (photo optionnelle)
  departments String[] // départements libres (F&B, Hospitality…) — ex-"sectors", RH-5 2026-07-30
  spaceIds    String[] // espaces desservis (ids Space, non contraint) — parité localStorage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles         HrRoleSupplier[]
  spaceDefaults HrRoleSpaceDefault[]
  staffLines    EventStaffLine[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Rôle RH (= « position ») — slide 4. Migre staff_positions du localStorage.
model HrRole {
  id            String   @id @default(cuid())
  tenantId      String
  department    String // 'F&B' | 'Merchandising' | 'Hospitality' | 'Entertainment'
  name          String // "Caissier", "Runner", …
  contractType  String? // 'CDD' | 'FREELANCE' | 'CDI' | 'AGENCY' | 'OTHER' — requis seulement si F&B
  rateType      String? // 'HOURLY' | 'DAILY' | 'MONTHLY' — requis si contractType ∈ {CDD, AGENCY, FREELANCE}
  rate          Float? // montant HT selon rateType
  fnbCategories String[] // Subtype.code du département 'shop' (ex. 'beverages', 'front_food') — vide = « NON LIÉ »
  algoKey       String? // 'RESPONSABLE_ZONE'|'RESPONSABLE_PDV'|'CAISSIER'|'RUNNER'|'BARMAN'|'CHEF_DE_PARTIE'|'COMMIS'|'EPR'|null
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  suppliers      HrRoleSupplier[] // multi-select si AGENCY
  persons        HrPerson[]
  spaceDefaults  HrRoleSpaceDefault[]
  staffLines     EventStaffLine[]
  sinkingRules   HrSinkingRule[]
  elementStaff   ElementStaff[] // lignes Staff Builder auto-remplies (source='AUTO')
  menuItemRatios HrRoleMenuItemRatio[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model HrRoleSupplier {
  roleId     String
  supplierId String

  role     HrRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  supplier HrSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([roleId, supplierId])
  @@index([roleId])
  @@index([supplierId])
}

/// Personne interne (CDI/CDD) — alimente le dropdown « Nom » des lignes staff.
model HrPerson {
  id           String   @id @default(cuid())
  tenantId     String
  roleId       String
  firstName    String
  lastName     String
  contractType String // 'CDI' | 'CDD'
  hourlyRate   Float? // override du taux du rôle, sinon null
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       HrRole           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  staffLines EventStaffLine[]

  @@index([tenantId, roleId])
}

/// Agence par défaut d'un espace pour un rôle donné (présélection fournisseur, slide 3).
model HrRoleSpaceDefault {
  id         String @id @default(cuid())
  spaceId    String
  roleId     String
  supplierId String

  space    Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  role     HrRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  supplier HrSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([spaceId, roleId])
  @@index([roleId])
  @@index([supplierId])
}

/// Ligne de staff par événement × PDV — sortie de l'algo + ajustements utilisateur.
/// Le coût PRÉDIT (figé à la génération) vit dans ElementPerformance.staffCost ;
/// le coût AJUSTÉ se recalcule depuis les lignes enabled (§5 spec RH).
model EventStaffLine {
  id           String   @id @default(cuid())
  tenantId     String
  eventId      String
  elementId    String // le PDV (SpaceElement type shop)
  roleId       String? // HrRole choisi ; null si rôle algo sans mapping
  algoKey      String? // rôle algo d'origine ('CAISSIER'…) ; null si ajout manuel
  enabled      Boolean  @default(true) // checkbox de désactivation (exclut du coût ajusté)
  source       String // 'ALGO' | 'MANUAL'
  userModified Boolean  @default(false) // ligne retouchée par l'utilisateur → jamais écrasée par une régénération
  supplierType String? // 'CDI' | 'CDD' | 'AGENCY' | …
  supplierId   String? // si AGENCY
  personId     String? // si CDI/CDD
  personLabel  String? // champ libre (défaut = nom de l'agence par défaut)
  hourlyRate   Float // taux horaire HT retenu pour la ligne
  startTime    DateTime // suggéré par l'algo (portes + offsets), ajustable au slider
  endTime      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  element  SpaceElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  role     HrRole?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  supplier HrSupplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  person   HrPerson?    @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([eventId, elementId])
  @@index([tenantId])
  @@index([roleId])
  @@index([elementId])
}

/// Règle « Sinking RH » (STF-2, 2026-07-30) — force un quota minimal d'un rôle
/// sur un PDV selon son tag F&B détecté (subtypes → fnbCategory, voir
/// SUBTYPE_TO_FNB_CATEGORY dans staffing.service.ts) et une condition optionnelle
/// sur SpaceElement.attributes (ex. nbFriteuses ≥ seuil). Appliquée en SUPPLÉMENT
/// du calcul par paliers (staffing-calculator.service.ts), jamais à sa place.
model HrSinkingRule {
  id                 String   @id @default(cuid())
  tenantId           String
  roleId             String
  fnbCategory        String // Subtype.code du département 'shop' (ex. 'beverages', 'front_food')
  conditionAttribute String? // clé JSON de SpaceElement.attributes (ex. 'nbFriteuses') ; null = toujours actif si le tag est présent
  conditionMinValue  Float? // seuil (attrs[conditionAttribute] >= conditionMinValue) ; ignoré si conditionAttribute est null
  mandatoryQty       Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  role HrRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, fnbCategory, conditionAttribute])
  @@index([tenantId])
  @@index([roleId])
}

/// Association Rôle ↔ Menu Item(s), scopée par espace (contrairement à HrSinkingRule qui est
/// scopé par tag F&B global) — résout QUESTIONS_A_BERTRAND.md #47. Un rôle est dimensionné selon
/// le volume de vente (CA ou Quantités) d'un ou plusieurs MenuItem sur CET espace :
/// qty = floor(valeur courante / ratioValue) * unitQty, sommé si plusieurs lignes visent le même
/// rôle (contrairement aux Sinking Rules qui prennent le max — ici chaque ligne est un driver de
/// charge additif : "+2 pour les burgers" et "+3 pour les frites" doivent s'additionner).
/// Voir 11_RH_STAFFING.md §11.15/§11.16.
model HrRoleMenuItemRatio {
  id           String   @id @default(cuid())
  tenantId     String
  spaceId      String
  roleId       String
  ratioBasis   String // 'REVENUE' | 'QUANTITY'
  ratioValue   Float // seuil ("tous les N")
  unitQty      Int      @default(1) // rôles accordés par seuil franchi
  allMenuItems Boolean  @default(false) // "Tout Sélectionner"
  menuItemIds  String[] @default([]) // ignoré si allMenuItems=true
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  space Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  role  HrRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([spaceId])
  @@index([roleId])
}

model Config {
  id        String   @id @default(cuid())
  name      String
  spaceId   String
  capacity  Int?
  data      Json?
  isSystem  Boolean  @default(false) // true = config auto-générée par le backend (import Weezevent), masquée côté UI
  version   Int      @default(0) // verrou optimiste pour la synchronisation de `data` (JSON) concurrente
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space                      Space                       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  floors                     Floor[]
  forecourt                  Forecourt?
  externalMerch              ExternalMerch?
  stations                   Station[]
  // Builder v2 : adhésions explicites élément ↔ configuration
  configurationElements      ConfigurationElement[]
  // Assignations menu scopées par config (éléments partagés entre configs en v2)
  menuAssignments            MenuAssignment[]
  // Perf/staff/inventaire d'élément scopés par config (même patron que menuAssignments)
  elementPerformances        ElementPerformance[]
  elementStaff               ElementStaff[]
  elementInventories         ElementInventory[]
  events                     Event[]
  elementMenuItemSalesInputs ElementMenuItemSalesInput[]

  @@index([spaceId])
}

// ==================== BUILDER V2 — ZONES & ADHÉSIONS ====================
// docs/REFONTE_3D_BUILDER_V2.md §2 : le relationnel est l'UNIQUE source de vérité.
// Une Zone appartient à l'ESPACE (pas à une config) ; une configuration est un
// ensemble d'adhésions (ConfigurationElement). Les éléments existent UNE fois.

model Zone {
  id        String   @id @default(cuid())
  spaceId   String
  kind      ZoneKind
  name      String
  level     Int      @default(0) // FLOOR : 0=RDC, <0 sous-sol, >0 étage ; 0 pour les autres kinds
  width     Float
  length    Float
  height    Float    @default(4)
  geometry  Json? // { cornerRadius, hole } — présentation pure, aucune jointure dessus
  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space    Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  elements SpaceElement[]

  // Un seul étage par niveau et par espace (et un seul parvis / une seule zone externe).
  @@unique([spaceId, kind, level])
  @@index([spaceId])
}

// Adhésion élément ↔ configuration : cocher = INSERT, décocher = DELETE,
// cloner une config = copie des lignes. Remplace `configurationIds` JSON de la v1.
model ConfigurationElement {
  configId  String
  elementId String
  createdAt DateTime @default(now())

  config  Config       @relation(fields: [configId], references: [id], onDelete: Cascade)
  element SpaceElement @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@id([configId, elementId])
  @@index([elementId])
}

// ==================== FLOOR & ELEMENTS ====================

model Floor {
  id           String @id @default(cuid())
  configId     String
  name         String
  level        Int
  width        Float
  height       Float
  length       Float
  cornerRadius Json?

  config   Config         @relation(fields: [configId], references: [id], onDelete: Cascade)
  elements SpaceElement[]

  @@index([configId])
  @@index([level])
}

// ==================== UNIFIED SPACE ELEMENT ====================
// Polymorphic: belongs to either a Floor or a Forecourt (one must be set)

model SpaceElement {
  id              String  @id @default(cuid())
  floorId         String? // FK to Floor (if element is inside a floor)
  forecourtId     String? // FK to Forecourt (if element is in forecourt)
  externalMerchId String? // FK to ExternalMerch (if element is in the external merch zone)
  zoneId          String? // Builder v2 : FK vers Zone (remplace les 3 FK ci-dessus pour les éléments v2)
  name            String
  // CFG-2 Étape 2 : `String` libre (ex-enum `ElementType`, converti en place, cf. migration
  // 20260731010500). Stocke `Department.code` (8 valeurs historiques : shop/hospitality/
  // merchshop/storage/entrance/kitchen/entertainment/access) ou `Department.id` (département
  // créé par le super-admin) — jamais `Department.name` (renommable). Le type Postgres
  // `ElementType` reste en base, orphelin, pour une réversibilité bon marché (DROP TYPE différé
  // en nettoyage final, Étape 7).
  type            String
  x               Float
  y               Float
  depth           Float?
  width           Float?
  height          Float?
  height3d        Float? // Hauteur 3D en mètres
  rotation        Float?  @default(0)
  image           String? @db.Text
  notes           String?
  capacity        Int?

  // Corner radius pour forme arrondie
  cornerRadiusTL Float? @default(0)
  cornerRadiusTR Float? @default(0)
  cornerRadiusBL Float? @default(0)
  cornerRadiusBR Float? @default(0)

  // Type-specific attributes (arrays stockés en JSON)
  shopTypes          String[]
  storageTypes       String[]
  hospitalityTypes   String[]
  accessTypes        String[]
  entertainmentTypes String[]
  entranceTypes      String[]
  kitchenTypes       String[]

  // Builder v2 : le `type` détermine le vocabulaire → une seule colonne de sous-types,
  // `area` promu en colonne (l'analytique le lisait dans attributes.area), verrou
  // optimiste PAR ÉLÉMENT (header If-Match).
  subtypes String[]
  area     String?
  version  Int      @default(0)

  attributes Json?
  tags       String[]

  // Relations
  floor                 Floor?                      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  forecourt             Forecourt?                  @relation(fields: [forecourtId], references: [id], onDelete: Cascade)
  externalMerch         ExternalMerch?              @relation(fields: [externalMerchId], references: [id], onDelete: Cascade)
  zone                  Zone?                       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  configurationElements ConfigurationElement[]
  // 1-N depuis le scoping par config : une ligne de perf PAR config adhérente
  performances          ElementPerformance[]
  staffPositions        ElementStaff[]
  inventoryItems        ElementInventory[]
  menuAssignments       MenuAssignment[]
  locationShopMappings  LocationShopMapping[]
  eventStaffLines       EventStaffLine[]
  menuItemSalesInputs   ElementMenuItemSalesInput[]

  @@index([floorId])
  @@index([forecourtId])
  @@index([externalMerchId])
  @@index([zoneId])
  @@index([type])
  @@index([floorId, type]) // Composite: shop queries filter by floor + type
  @@index([forecourtId, type]) // Composite: shop queries filter by forecourt + type
  // Réconciliation du drift avec 20260731000000_analyse_page_perf_indexes (branche Zone/Builder v2
  // de la résolution v_shop_ids dans la RPC get_space_shop_details).
  @@index([zoneId, type])
}

// ==================== ELEMENT PERFORMANCE ====================

model ElementPerformance {
  id                    String   @id @default(cuid())
  elementId             String
  // Scope par CONFIGURATION (même patron que MenuAssignment) : un élément v2 partagé
  // entre configs peut avoir des métriques différentes en config Concert vs Match.
  // null = élément orphelin sans config adhérente.
  configId              String?
  revenue               Float?   @default(0)
  numberOfPOS           Int?     @default(0)
  numberOfTransactions  Float?   @default(0)
  transactionsPerMinute Float?   @default(0)
  staffCost             Float?   @default(0)
  revenuePerEmployee    Float?   @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  element SpaceElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  config  Config?      @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([elementId, configId])
  @@index([elementId])
  @@index([configId])
}

// ==================== ELEMENT STAFF ====================

model ElementStaff {
  id         String   @id @default(cuid())
  elementId  String
  // Scope par CONFIGURATION (cf. ElementPerformance) — staffing différent par config.
  configId   String?
  position   String // "Cashier", "Cook", "Security", etc.
  count      Int      @default(1)
  hourlyRate Float?
  // Auto-remplissage depuis les règles Sinking RH (2026-07-30) : roleId trace le HrRole
  // d'origine (position régénérée depuis role.name à chaque sync), source distingue une
  // ligne posée par la règle ('AUTO', resynchronisée sans jamais toucher aux lignes
  // tapées à la main) d'une ligne manuelle ('MANUAL', défaut — parité des lignes
  // existantes avant cette migration).
  roleId     String?
  source     String   @default("MANUAL") // 'AUTO' | 'MANUAL'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  element SpaceElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  config  Config?      @relation(fields: [configId], references: [id], onDelete: Cascade)
  role    HrRole?      @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([elementId])
  @@index([configId])
  @@index([roleId])
}

/// Valeur "vendu/prévu" par Menu Item, par élément (shop), par config (événement) — jamais par
/// espace seul (leçon de 11_RH_STAFFING.md §11.14 : une quantité prévue est event-scoped, pas un
/// attribut fixe de l'espace). `source` distingue qui a écrit la valeur ; seul 'MANUAL' est
/// implémenté dans ce chantier — 'LIVE'/'PREDICT' anticipent un futur branchement (Weezevent live,
/// Event Predict) sans changer ce modèle ni le moteur de calcul qui le lit. Voir §11.16.
model ElementMenuItemSalesInput {
  id         String   @id @default(cuid())
  tenantId   String
  elementId  String
  configId   String?
  menuItemId String
  quantity   Float?
  revenueHt  Float?
  source     String   @default("MANUAL") // 'MANUAL' | 'LIVE' | 'PREDICT'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  element  SpaceElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  config   Config?      @relation(fields: [configId], references: [id], onDelete: Cascade)
  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([elementId, configId, menuItemId])
  @@index([tenantId])
  @@index([elementId, configId])
  @@index([menuItemId])
}

// ==================== ELEMENT INVENTORY ====================

model ElementInventory {
  id         String   @id @default(cuid())
  elementId  String
  // Scope par CONFIGURATION (cf. ElementPerformance) — stock prévu différent par config.
  configId   String?
  name       String
  quantity   Float    @default(0)
  unit       String? // "units", "kg", "liters", etc.
  minStock   Float? // Niveau minimum d'alerte
  maxStock   Float? // Capacité maximum
  isCustom   Boolean  @default(true)
  menuItemId String? // Référence optionnelle à un item du menu
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  element SpaceElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  config  Config?      @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([elementId])
  @@index([configId])
  @@index([name])
}

model Forecourt {
  id       String @id @default(cuid())
  configId String @unique
  name     String
  width    Float
  length   Float

  config   Config         @relation(fields: [configId], references: [id], onDelete: Cascade)
  elements SpaceElement[]
}

// Zone "External Merch" (merchandising extérieur), miroir de Forecourt.
model ExternalMerch {
  id       String @id @default(cuid())
  configId String @unique
  name     String
  width    Float
  length   Float

  config   Config         @relation(fields: [configId], references: [id], onDelete: Cascade)
  elements SpaceElement[]
}

// ==================== SUPPLIER & MARKET PRICES ====================

model Supplier {
  id               String   @id @default(cuid())
  name             String
  email            String
  tel              String
  city             String
  address          String
  postcode         String
  picture          String?
  notes            String?
  sites            String[] // Array of spaceIds
  contactName      String
  configurationIds String[] @default([])
  sectors          String[] @default([])
  tenantId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  marketPrices MarketPrice[]

  @@index([tenantId])
  @@index([name])
}

model MarketPrice {
  id                     String    @id @default(cuid())
  unit                   String
  image                  String?
  price                  Decimal   @db.Decimal(10, 2)
  goodType               String
  itemName               String
  category               String?
  supplierItem           String?
  recipeUnit             String?
  purchaseUnitConversion Float?
  supplier               String? // Nom du fournisseur
  supplierId             String? // ID du fournisseur
  pricePerUnit           Decimal?  @db.Decimal(10, 4)
  packedUnits            Float?
  numberOfUnits          Float?
  unitsPerPurchase       Float?
  packingWidth           Float?
  packingHeight          Float?
  packingLength          Float?
  purchasePackaging      String? // Emballage d'achat ("Item is purchased in", ex: Box)
  inventoryPackaging     String? // Emballage de stockage ("Item is stored in", ex: Bag)
  storageType            String? // Type de stockage (référentiel StorageType : Dry/Cold/Frozen) défini au niveau du prix fournisseur (supplier item)
  // Taxonomie dynamique propre à Market Price (séparée de Menu Item).
  // `goodType` (texte libre, ex-enum) reste le discriminateur fonctionnel qui
  // pilote l'auto-création Ingredient/Packaging quand il vaut littéralement
  // "Food"/"Beverage"/"Packaging".
  marketPriceTypeId      String? // FK -> MarketPriceType
  marketPriceCategoryId  String? // FK -> MarketPriceCategory
  industrialId           String? // FK -> Industrial (façonnier/industriel de la ligne d'achat)
  tenantId               String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierRel         Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  marketPriceType     MarketPriceType?     @relation(fields: [marketPriceTypeId], references: [id], onDelete: SetNull)
  marketPriceCategory MarketPriceCategory? @relation(fields: [marketPriceCategoryId], references: [id], onDelete: SetNull)
  industrial          Industrial?          @relation(fields: [industrialId], references: [id], onDelete: SetNull)
  ingredients         Ingredient[]
  packagings          Packaging[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([goodType])
  @@index([itemName])
  @@index([category])
  @@index([marketPriceTypeId])
  @@index([marketPriceCategoryId])
  @@index([industrialId])
}

// ==================== WEEZEVENT SYNC ====================

model SalesEvent {
  id            String @id @default(cuid())
  externalId    String @map("weezeventId")
  tenantId      String
  integrationId String

  // Event data
  name           String
  organizationId String
  startDate      DateTime?
  endDate        DateTime?
  description    String?
  location       String?
  capacity       Int?
  status         String?

  // Link to DataFriday Config (set after Step 1 location-space mapping)
  configurationId String?

  // Metadata
  metadata Json?
  rawData  Json

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  syncedAt  DateTime @default(now())

  // Relations
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration  Integration         @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  transactions SalesTransaction[]
  locations    SalesLocation[]
  orders       WeezeventOrder[]
  prices       WeezeventPrice[]
  attendees    WeezeventAttendee[]
  events       Event[]             @relation("EventWeezeventEvent")

  @@unique([tenantId, integrationId, externalId])
  @@index([tenantId])
  @@index([integrationId])
  @@index([externalId])
  @@index([startDate])
  @@map("WeezeventEvent")
}

model WeezeventMerchant {
  id            String @id @default(cuid())
  weezeventId   String
  tenantId      String
  integrationId String

  // Merchant data
  name           String
  organizationId String
  description    String?
  email          String?
  phone          String?
  address        Json?

  // Metadata
  metadata Json?
  rawData  Json

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  syncedAt  DateTime @default(now())

  // Relations
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration  Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  transactions SalesTransaction[]

  @@unique([tenantId, integrationId, weezeventId])
  @@index([tenantId])
  @@index([integrationId])
  @@index([weezeventId])
}

model SalesLocation {
  id            String              @id @default(cuid())
  externalId    String              @map("weezeventId")
  tenantId      String
  integrationId String
  provider      IntegrationProvider @default(WEEZEVENT)
  eventId       String?

  // Location data
  name        String
  type        String?
  capacity    Int?
  coordinates Json?

  // Metadata
  metadata Json?
  rawData  Json

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  syncedAt  DateTime @default(now())

  // Relations
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration  Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  event        SalesEvent?        @relation(fields: [eventId], references: [id])
  transactions SalesTransaction[]

  @@unique([tenantId, integrationId, externalId])
  @@index([tenantId])
  @@index([integrationId])
  @@index([externalId])
  @@index([eventId])
  @@map("WeezeventLocation")
}

model SalesProduct {
  id            String              @id @default(cuid())
  externalId    String              @map("weezeventId")
  tenantId      String
  integrationId String
  provider      IntegrationProvider @default(WEEZEVENT)

  // Product data
  name        String
  description String?
  nature      String?
  subnature   String?
  productType String?
  categoryId  String?
  basePrice   Decimal? @db.Decimal(10, 2)
  vatRate     Decimal? @db.Decimal(5, 2)
  image       String?
  allergens   String[]

  // Composition
  isCompound Boolean @default(false)
  components Json?
  variants   Json?

  // Metadata
  metadata Json?
  rawData  Json

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  syncedAt  DateTime @default(now())

  // Relations
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration       Integration             @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  transactionItems  SalesTransactionItem[]
  mappings          ProductMapping[]
  productVariants   SalesProductVariant[]
  productComponents SalesProductComponent[]
  prices            WeezeventPrice[]

  @@unique([tenantId, integrationId, externalId])
  @@index([tenantId])
  @@index([integrationId])
  @@index([externalId])
  @@index([nature])
  @@index([subnature])
  @@index([productType])
  @@index([tenantId, provider]) // catalogue mixte → wizard filtre/étiquette par source
  @@map("WeezeventProduct")
}

model WeezeventUser {
  id            String @id @default(cuid())
  weezeventId   String
  tenantId      String
  integrationId String

  // User data (Client)
  email     String?
  firstName String?
  lastName  String?
  phone     String?
  birthdate DateTime?
  address   Json?

  // Wallet
  walletId String?

  // GDPR
  gdprConsent      Boolean @default(false)
  marketingConsent Boolean @default(false)

  // Metadata
  metadata Json?
  rawData  Json

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  syncedAt  DateTime @default(now())

  // Relations
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
