model MenuComponent {
  id                  String       @id @default(cuid())
  name                String
  unit                String
  category            String // Flexible pour "Food", "Sauce", etc.
  unitCost            Decimal?     @db.Decimal(10, 4)
  allergens           String[]
  description         String?
  storageType         String?
  subComponents       Json? // Pour stocker les subComponents JSON de Figma
  componentCategory   String? // "Veg", "Sauce", etc.
  numberOfUnitsRecipe Float? // Nombre d'unités par recette (rendement de batch — peut être fractionnaire, ex. 0.75 kg)
  packedUnits         Float?
  inventoryPackaging  String? // Emballage de stockage ("Item is stored in", ex: Box)
  readyForSale        String? // "Yes", "No" ou null — même contrat que MenuItem.readyForSale
  kitchenType         KitchenType? // Cuisine Centrale/Locale, saisi quand readyForSale = "Yes"
  // Taxonomie dynamique dédiée Component (indépendante de ProductType/ProductCategory
  // et de MarketPriceType/MarketPriceCategory). `category`/`componentCategory`
  // (texte libre ci-dessus) restent le contrat fonctionnel existant, inchangés.
  componentTypeId     String? // FK -> ComponentType
  componentCategoryId String? // FK -> ComponentCategory
  tenantId            String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredients          ComponentIngredient[]
  children             ComponentComponent[]  @relation("ParentToChild")
  parents              ComponentComponent[]  @relation("ChildToParent")
  usedIn               MenuItemComponent[]
  // Relation nommée `componentCategoryRef` (et non `componentCategory`) pour éviter
  // la collision avec le champ texte libre `componentCategory` ci-dessus.
  componentType        ComponentType?        @relation(fields: [componentTypeId], references: [id], onDelete: SetNull)
  componentCategoryRef ComponentCategory?    @relation(fields: [componentCategoryId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([name])
  @@index([category])
  @@index([componentTypeId])
  @@index([componentCategoryId])
  @@index([readyForSale])
}

