{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "frontend-local-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VUE_APP_API_URL=http://localhost:3001/api/v1 npm run dev --prefix frontend"
      ],
      "port": 3000
    }
  ]
}
