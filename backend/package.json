{
  "name": "api-datafriday",
  "version": "1.0.0",
  "description": "API DataFriday - NestJS with Fastify and Prisma for Supabase",
  "author": "",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "rm -f tsconfig.build.tsbuildinfo && nest build",
    "docs:api": "node scripts/generate-api-reference.mjs && node scripts/export-openapi.mjs",
    "openapi:export": "node scripts/export-openapi.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "rm -f tsconfig.build.tsbuildinfo && nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "knip": "knip",
    "jscpd": "jscpd",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/db-guard.cjs 'prisma migrate dev' && prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/db-guard.cjs 'prisma migrate deploy' && prisma migrate deploy",
    "db:deploy": "node scripts/db-guard.cjs 'prisma migrate deploy' && prisma migrate deploy && prisma generate",
    "prisma:studio": "node scripts/db-guard.cjs 'prisma studio' && prisma studio",
    "prisma:seed": "node scripts/db-guard.cjs seed && npx tsx prisma/seed.ts",
    "rbac:backfill": "node scripts/db-guard.cjs backfill && npx tsx prisma/backfill-rbac.ts",
    "rbac:backfill-stats-financial-view": "node scripts/db-guard.cjs backfill && npx tsx prisma/backfill-stats-financial-view.ts",
    "stock-identity:backfill": "node scripts/db-guard.cjs backfill && npx tsx prisma/backfill-stock-item-identity.ts",
    "images:migrate-to-storage": "node scripts/db-guard.cjs migration && npx tsx prisma/migrate-images-to-storage.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "5.22.0",
    "@prisma/client": "^5.7.1",
    "@supabase/supabase-js": "^2.108.2",
    "axios": "^1.13.2",
    "bullmq": "^5.66.5",
    "chardet": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "csv-parse": "^7.0.1",
    "fastify": "^4.25.2",
    "iconv-lite": "^0.7.3",
    "ioredis": "^5.9.2",
    "joi": "^18.2.1",
    "jwks-rsa": "^4.1.0",
    "nestjs-cls": "^6.2.1",
    "nestjs-pino": "^4.6.1",
    "opossum": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
