model SalesTransaction {
  id            String              @id @default(cuid())
  externalId    String              @map("weezeventId")
  tenantId      String
  integrationId String
  provider      IntegrationProvider @default(WEEZEVENT)

  // Transaction data
  amount          Decimal  @db.Decimal(10, 2)
  status          String
  transactionDate DateTime

  // Event and merchant info
  eventId      String?
  eventName    String?
  merchantId   String?
  merchantName String?
  locationId   String?
  locationName String?

  // Seller info
  sellerWalletId String?

  // Metadata
  metadata Json?
  rawData  Json

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  syncedAt  DateTime @default(now())

  // BUG-028 : soft-delete réel — auparavant markTransactionAsDeleted() ne faisait que toucher
  // syncedAt, ne marquant rien comme supprimé malgré son nom. Une transaction supprimée côté
  // Weezevent (webhook "delete") est maintenant horodatée ici et exclue de l'agrégation.
  deletedAt DateTime?

  // Relations
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration  Integration            @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  event        SalesEvent?            @relation(fields: [eventId], references: [id])
  merchant     WeezeventMerchant?     @relation(fields: [merchantId], references: [id])
  location     SalesLocation?         @relation(fields: [locationId], references: [id])
  sellerWallet WeezeventWallet?       @relation("SellerWallet", fields: [sellerWalletId], references: [id])
  items        SalesTransactionItem[]

  @@unique([tenantId, integrationId, externalId])
  @@index([tenantId])
  @@index([integrationId])
  @@index([externalId])
  @@index([eventId])
  @@index([merchantId])
  @@index([locationId])
  @@index([status])
  @@index([transactionDate])
  @@index([deletedAt])
  @@index([syncedAt])
  @@index([sellerWalletId]) // Added walletId index
  // Composite indexes for analytics
  @@index([tenantId, status, transactionDate])
  @@index([tenantId, eventId, status])
  @@index([eventId, transactionDate])
  @@index([tenantId, locationId, transactionDate]) // Aggregation query: WHERE tenantId + locationId IN (...) + transactionDate range
  @@index([tenantId, integrationId, transactionDate]) // step4-context: WHERE tenantId + integrationId + transactionDate range
  @@index([tenantId, provider]) // filtre des ventes par source (dashboards, exports, debug)
  // Réconciliation du drift avec 20260731000000_analyse_page_perf_indexes (index créés en SQL,
  // jamais reportés ici — un `prisma migrate dev` les aurait silencieusement droppés).
  // map: obligatoire sur le premier — Postgres a tronqué le nom à 63 caractères à la création.
  @@index([tenantId, integrationId, status, transactionDate], map: "WeezeventTransaction_tenantId_integrationId_status_transactionD") // resolveEventSalesScope (event-timeline / transaction-baskets)
  @@index([tenantId, locationId, status]) // RPC get_space_shop_details : _space_event_ids
  // BUG-128-01 : rend le scan _space_event_ids de la RPC index-only (eventId dans la clé) —
  // sans lui, le planner passait par locationId seul + re-filtre heap (185k lignes, ~11 s).
  @@index([tenantId, locationId, status, eventId])
  @@map("WeezeventTransaction")
}

// ==================== WEEZEVENT SYNC STATE ====================

// Track sync state per tenant/type for incremental sync
model WeezeventSyncState {
  id            String @id @default(cuid())
  tenantId      String
  integrationId String
  syncType      String // 'events', 'transactions', 'products', 'wallets', 'users'

  // Cursor-based sync (most efficient)
  lastSyncedAt    DateTime? // Last successful sync time
  lastCursor      String? // API cursor for pagination
  lastWeezeventId String? // Last processed Weezevent ID
  lastUpdatedAt   DateTime? // Last 'updated_at' from API

  // Stats
  totalSynced       Int     @default(0)
  lastSyncCount     Int     @default(0)
  lastSyncDuration  Int? // Duration in ms
  lastError         String?
  consecutiveErrors Int     @default(0)

  // Checkpoints for large syncs
  checkpoint Json? // Store progress for resumable syncs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, integrationId, syncType])
  @@index([tenantId])
  @@index([integrationId])
  @@index([syncType])
  @@index([lastSyncedAt])
}

// ==================== WEEZEVENT WEBHOOK ====================

model IntegrationWebhookEvent {
  id            String              @id @default(cuid())
  tenantId      String
  integrationId String
  provider      IntegrationProvider @default(WEEZEVENT)

  // Webhook data
  eventType String // transaction, refill, transfer, wallet | order.completed, order.refunded (Digifood)
  method    String // create, update, delete | sale, refund, order (Digifood, data.type normalisé)
  payload   Json // Full webhook body
  signature String? // X-Weezevent-Signature | digifood-wh-signature header

  // Dédup Digifood : payload.id (UUID de livraison, stable entre retries 24 h)
  externalDeliveryId String?

  // Processing
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  retryCount  Int       @default(0)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalDeliveryId])
  @@index([tenantId])
  @@index([integrationId])
  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
  @@map("WeezeventWebhookEvent")
}

model SalesTransactionItem {
  id             String  @id @default(cuid())
  transactionId  String
  externalItemId String? @map("weezeventItemId")

  // Item data
  productId   String?
  productName String?
  compoundId  String?
  // Float : ventes fractionnaires (poids, formules à ratio) — l'ingestion tronquait du CA
  quantity    Float
  unitPrice   Decimal @db.Decimal(10, 2)
  vat         Decimal @db.Decimal(5, 2)
  // (10,2) : c'est un MONTANT de remise, pas un % — (5,2) plafonnait à 999,99
  reduction   Decimal @default(0) @db.Decimal(10, 2)

  // Metadata
  rawData Json

  // Audit
  createdAt DateTime @default(now())

  // Relations
  transaction SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     SalesProduct?    @relation(fields: [productId], references: [id])
  payments    SalesPayment[]

  @@index([transactionId])
